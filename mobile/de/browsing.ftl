browsing-created-ago = vor { $span } erstellt
browsing-edited-ago = vor { $span } bearbeitet
# Browse select-mode bulk bar; opens Add Tags / Remove Tags
browsing-bulk-tag = Schlagwort
# Browse select-mode bulk bar; change the deck of selected cards
browsing-bulk-move = Verschieben
# Confirmation pill after swipe/context-menu suspend (Undo is the pill action).
browsing-card-suspended-undo = Karte ausgeschlossen
# Message in the confirmation shown before deleting notes, in Browse and on the study screen. $count is the number of notes being deleted.
browsing-delete-notes-confirm =
    { $count ->
        [one] { $count } Notiz und alle zugehörigen Karten löschen?
       *[other] { $count } Notizen und alle zugehörigen Karten löschen?
    }
# Follows "N cards buried." after Toggle Bury in Browse, when some selected cards were suspended and couldn't be buried. $count is the number of those suspended cards.
browsing-suspended-cards-skipped =
    { $count ->
        [one] { $count } ausgeschlossene Karte übersprungen.
       *[other] { $count } ausgeschlossene Karten übersprungen.
    }
# Shown under the zero-results title in Browse
browsing-empty-no-match-subtitle = Entfernen Sie einen der obigen Filter oder löschen Sie die Suchanfrage, um alles anzuzeigen.
# Shown under the empty-collection title in Browse
browsing-empty-collection-subtitle = Fügen Sie über die Stapelübersicht neue Stapel hinzu oder laden Sie welche herunter.
# Shown as an action row in bulk Add Tags when the typed name doesn't match any existing tag; tapping queues the name(s) for creation
browsing-add-tag-name = "{ $name }" hinzufügen
# Section header for new tags queued in bulk Add Tags but not yet applied
browsing-new-tags = Neue Schlagwörter

