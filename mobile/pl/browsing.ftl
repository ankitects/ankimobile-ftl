browsing-sort-backwards = Odwrotne sortowanie
# Section header in browse Options for metadata shown on each card row
browsing-card-row-details = Szczegóły rzędu kart
# Shown under Card Row Details in browse Options, above the detail options
browsing-card-row-details-description = Zmień, jaka informacja jest pokazywana dla każdej karty lub notatki. Nazwa talii jest pokazywana automatycznie, gdy wyniki wyszukiwania zawierają więcej niż jedną talię.
# Section header in browse Options for tap/swipe actions
browsing-gestures = Gesty
# Shown under Gestures in browse Options, above the gesture options
browsing-gestures-description = Przyporządkuj działania do gestów w celu szybkiego ich wykonywania. Wszystkie działania są zawsze widocznie poprzez długie przyciśnięcie wiersza.
# Label for a detail slot; {$number} is 1–3
browsing-detail-number = Szczegóły { $number }
browsing-hide-answers = Ukryj odpowiedzi
browsing-tap = Naciśnięcie
# Second swipe-left gesture (after the primary swipe left)
browsing-swipe-left-second = Przesunięcie w lewo (drugie)
# Shown on a card row; {$span} is a compact timespan like "3d"
browsing-created-ago = utworzono { $span } temu
browsing-edited-ago = edytowano { $span } temu
# Browse select-mode bulk bar; opens Add Tags / Remove Tags
browsing-bulk-tag = Tag
# Browse select-mode bulk bar; change the deck of selected cards
browsing-bulk-move = Przenieś
# Browse select-mode More menu in Notes mode; suspends every card of each selected note
browsing-suspend-all-cards = Zawieś wszystkie karty
# Browse select-mode More menu in Notes mode; unsuspends every suspended card of each selected note
browsing-unsuspend-all-cards = Odwieś wszystkie karty
# Confirmation pill after swipe/context-menu suspend (Undo is the pill action).
browsing-card-suspended-undo = Karta zawieszona
# Message in the confirmation shown before deleting notes, in Browse and on the study screen. $count is the number of notes being deleted.
browsing-delete-notes-confirm =
    { $count ->
        [one] Usunąć { $count } notatkę i wszystkie jej karty?
        [few] Usunąć { $count } notatki i wszystkie ich karty?
       *[many] Usunąć { $count } notatek  i wszystkie ich karty?
    }
# Follows "N cards buried." after Toggle Bury in Browse, when some selected cards were suspended and couldn't be buried. $count is the number of those suspended cards.
browsing-suspended-cards-skipped =
    { $count ->
        [one] Pominięto { $count } zawieszoną kartę.
        [few] Pominięto { $count } zawieszone karty.
       *[many] Pominięto { $count } zawieszonych kart.
    }
# Shown under the zero-results title in Browse
browsing-empty-no-match-subtitle = Usuń filtr powyżej lub wyczyść wyszukiwanie, aby zobaczyć wszystko
# Shown under the empty-collection title in Browse
browsing-empty-collection-subtitle = Dodaj lub pobierz talie z ekranu Talii
# Shown as an action row in bulk Add Tags when the typed name doesn't match any existing tag; tapping queues the name(s) for creation
browsing-add-tag-name = Dodaj "{ $name }"
# Shown as an action row in bulk Add Tags when two or more new tag names are typed, separated by spaces
browsing-add-tag-names = Dodaj { $count } tagów: { $names }
# Section header for new tags queued in bulk Add Tags but not yet applied
browsing-new-tags = Nowe tagi

