# Shown on a card row; {$span} is a compact timespan like "3d"
browsing-created-ago = أنشئت قبل { $span }
browsing-edited-ago = عدلت قبل { $span }
# Browse select-mode bulk bar; opens Add Tags / Remove Tags
browsing-bulk-tag = وسم
# Browse select-mode bulk bar; change the deck of selected cards
browsing-bulk-move = نقل
# Browse select-mode More menu in Notes mode; suspends every card of each selected note
browsing-suspend-all-cards = تعليق كل البطاقات
# Browse select-mode More menu in Notes mode; unsuspends every suspended card of each selected note
browsing-unsuspend-all-cards = إلغاء تعليق كل البطاقات
# Confirmation pill after swipe/context-menu suspend (Undo is the pill action).
browsing-card-suspended-undo = عُلِّقت البطاقة
# Message in the confirmation shown before deleting notes, in Browse and on the study screen. $count is the number of notes being deleted.
browsing-delete-notes-confirm =
    { $count ->
        [zero] هل تريد حذف { $count } ملحوظة وكل بطاقاتها؟
        [one] هل تريد حذف الملحوظة وكل بطاقاتها؟
        [two] هل تريد حذف الملحوظتين وكل بطاقاتها؟
        [few] هل تريد حذف { $count } ملحوظات وكل بطاقاتها؟
        [many] هل تريد حذف { $count } ملحوظة وكل بطاقاتها؟
       *[other] هل تريد حذف { $count } ملحوظة وكل بطاقاتها؟
    }
# Follows "N cards buried." after Toggle Bury in Browse, when some selected cards were suspended and couldn't be buried. $count is the number of those suspended cards.
browsing-suspended-cards-skipped =
    { $count ->
        [zero] تم تخطي { $count } بطاقة معلقة.
        [one] تم تخطي بطاقة واحدة معلقة.
        [two] تم تخطي بطاقتين معلقتين.
        [few] تم تخطي { $count } بطاقات معلقة.
        [many] تم تخطي { $count } بطاقة معلقة.
       *[other] تم تخطي { $count } بطاقة معلقة.
    }
# Shown under the zero-results title in Browse
browsing-empty-no-match-subtitle = احذف فلتر من الأعلى، أو امسح البحث لرؤية كل شيء
# Shown under the empty-collection title in Browse
browsing-empty-collection-subtitle = أضف أو نزل رزمًا من شاشة الرزم
# Shown as an action row in bulk Add Tags when the typed name doesn't match any existing tag; tapping queues the name(s) for creation
browsing-add-tag-name = أضف "{ $name }"
# Shown as an action row in bulk Add Tags when two or more new tag names are typed, separated by spaces
browsing-add-tag-names = أضف { $count } وسم: { $names }
# Section header for new tags queued in bulk Add Tags but not yet applied
browsing-new-tags = وسوم جديدة

