# Message in the confirmation shown before deleting a deck. $name is the deck's name; $count is the number of cards in the deck, including its subdecks.
decks-delete-deck-confirm =
    { $count ->
        [zero] هل تريد حذف { $name }؟
        [one] هل تريد حذف { $name } وبطاقتها الواحدة؟
        [two] هل تريد حذف { $name } وبطاقاتها الاثنتين؟
        [few] هل تريد حذف { $name } وبطاقاتها ({ $count })؟
        [many] هل تريد حذف { $name } وبطاقاتها ({ $count })؟
       *[other] هل تريد حذف { $name } وبطاقاتها ({ $count })؟
    }
