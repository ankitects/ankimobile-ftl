# Title of the post-update tip sheet shown once after upgrading
whats-new-title = Uutta AnkiMobilessa
# Feature title on the What's New tip sheet
whats-new-browse-title = Parempi tapa selata
# Feature description on the What's New tip sheet
whats-new-browse-body = Selausnäkymä on täysin uudistettu ja entistä selkeämpi: uudelleen suunnitellut korttirivit, mukautettavat eleet, joustava lajittelu ja toimintoja useiden korttien käsittelyyn kerralla.
# Feature title on the What's New tip sheet
whats-new-search-title = Tehokas uusi haku
# Feature description on the What's New tip sheet
whats-new-search-body = Luo hakuja visuaalisesti suodattimien avulla, kirjoita kyselyitä suoraan hakusyntaksin avulla ja palaa nopeasti viimeaikaisiin ja tallennettuihin hakuihin.
# Feature title on the What's New tip sheet
whats-new-decks-title = Pakat yhdellä vilkaisulla
# Feature description on the What's New tip sheet
whats-new-decks-body = Näet nyt uusien, opittavien ja kerrattavien korttien lukumäärät suoraan pakkalistasta. Lisäksi synkronoinnin tila näkyy selkeämmin ja ulkoasu on uudistettu. Mikäli haluat yksinkertaisemman näkymän, ota käyttöön kompakti tila, joka on selkeämpi ja sisältää vähemmän tietoa.
